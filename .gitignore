# Evidence and scratch. The audit clones are reference material for the PoW work and
# are deliberately NOT part of the deliverable.
_audit/
.probe/
spike/

# Throwaway / local state
.npm-cache/
.npm-install.log
.wrangler/
node_modules/
dist/
.dryrun/

# Never commit credentials. The DeepSeek session token and any API keys live in
# Worker secrets (wrangler secret put), .dev.vars (what `wrangler dev` reads), or .env
# (what scripts/setup-wizard.sh captures). All three hold real secrets.
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example
*.pem

# Built console. Regenerated by 'npm run build:web' before every deploy.
web/dist/

# SSR render-check bundle (test tooling, never deployed).
web/build-test/

# Local deployment config with this account's real D1 id and domain.
# The tracked wrangler.toml is the public template.
wrangler.local.toml

# Local-only setup notes; not published.
SETUP-GUIDE.md
